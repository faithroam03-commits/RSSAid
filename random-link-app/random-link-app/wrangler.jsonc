{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rssaid",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1002",
     "simple": {
  "limit": 30,
  "period": 60
}
    }
  ],
  "observability": {
    "enabled": true
  }
}